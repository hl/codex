#!/bin/sh
set -eu

usage() {
  printf '%s\n' "usage: watch-agent --detach <agent> <prompt> | --rearm <agent> | --adopt <agent> | --adopt-all | --list | --clear <agent>" >&2
  exit 2
}

state_root() {
  if [ -n "${PIEN_STATE_DIR:-}" ]; then
    printf '%s\n' "$PIEN_STATE_DIR"
  elif [ -n "${XDG_STATE_HOME:-}" ]; then
    printf '%s\n' "$XDG_STATE_HOME/pien"
  else
    printf '%s\n' "$HOME/.local/state/pien"
  fi
}

prepare_state() {
  PIEN_WATCH_ROOT=$(state_root)
  PIEN_WATCH_RECORDS=$PIEN_WATCH_ROOT/watches
  PIEN_WATCH_TARGETS=$PIEN_WATCH_ROOT/targets
  PIEN_WATCH_LOGS=$PIEN_WATCH_ROOT/logs
  PIEN_WATCH_PROMPTS=$PIEN_WATCH_ROOT/prompts
  PIEN_WATCH_LEASES=$PIEN_WATCH_ROOT/leases
  mkdir -p "$PIEN_WATCH_RECORDS" "$PIEN_WATCH_TARGETS" "$PIEN_WATCH_LOGS" "$PIEN_WATCH_PROMPTS" "$PIEN_WATCH_LEASES"
  chmod 700 "$PIEN_WATCH_ROOT" "$PIEN_WATCH_RECORDS" "$PIEN_WATCH_TARGETS" "$PIEN_WATCH_LOGS" "$PIEN_WATCH_PROMPTS" "$PIEN_WATCH_LEASES"
  export PIEN_WATCH_ROOT PIEN_WATCH_RECORDS PIEN_WATCH_TARGETS PIEN_WATCH_LOGS PIEN_WATCH_PROMPTS PIEN_WATCH_LEASES
}

require_commands() {
  for command_name in jq herdr codex; do
    command -v "$command_name" >/dev/null 2>&1 || {
      printf '%s\n' "watch-agent requires $command_name" >&2
      exit 1
    }
  done
}

require_controller() {
  [ "${HERDR_ENV:-}" = "1" ] || {
    printf '%s\n' "watch-agent requires HERDR_ENV=1" >&2
    exit 1
  }
  [ -n "${CODEX_THREAD_ID:-}" ] || {
    printf '%s\n' "watch-agent requires CODEX_THREAD_ID" >&2
    exit 1
  }
}

validate_agent() {
  agent_name=$1
  case "$agent_name" in
    ''|[!a-z]*|*[!a-z0-9_-]*)
      printf '%s\n' "invalid agent name: $agent_name" >&2
      exit 2
      ;;
  esac
  [ "${#agent_name}" -le 32 ] || {
    printf '%s\n' "agent name exceeds 32 characters: $agent_name" >&2
    exit 2
  }
}

record_path() {
  printf '%s/%s.json\n' "$PIEN_WATCH_RECORDS" "$1"
}

target_path() {
  printf '%s/%s.thread\n' "$PIEN_WATCH_TARGETS" "$1"
}

process_start() {
  ps -ww -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

process_identity_matches() {
  candidate_pid=$1
  expected_start=$2
  case "$candidate_pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$candidate_pid" -gt 0 ] || return 1
  kill -0 "$candidate_pid" 2>/dev/null || return 1
  [ -n "$expected_start" ] && [ "$(process_start "$candidate_pid")" = "$expected_start" ]
}

release_lock() {
  [ -n "${PIEN_WATCH_LOCK:-}" ] || return 0
  rm -f "$PIEN_WATCH_LOCK/owner"
  rmdir "$PIEN_WATCH_LOCK" 2>/dev/null || true
  PIEN_WATCH_LOCK=
}

acquire_lock() {
  agent_name=$1
  PIEN_WATCH_LOCK=$PIEN_WATCH_RECORDS/.${agent_name}.lock
  lock_attempt=0
  while ! mkdir "$PIEN_WATCH_LOCK" 2>/dev/null; do
    owner_pid=
    owner_start=
    if [ -f "$PIEN_WATCH_LOCK/owner" ]; then
      owner_pid=$(sed -n '1p' "$PIEN_WATCH_LOCK/owner")
      owner_start=$(sed -n '2p' "$PIEN_WATCH_LOCK/owner")
    fi
    lock_busy=false
    if [ -z "$owner_pid" ] || [ -z "$owner_start" ]; then
      lock_mtime=$(stat -f '%m' "$PIEN_WATCH_LOCK" 2>/dev/null || stat -c '%Y' "$PIEN_WATCH_LOCK" 2>/dev/null || printf '0')
      lock_age=$(($(date +%s) - lock_mtime))
      [ "$lock_age" -ge 10 ] || lock_busy=true
    elif process_identity_matches "$owner_pid" "$owner_start"; then
      lock_busy=true
    fi
    if [ "$lock_busy" = true ]; then
      lock_attempt=$((lock_attempt + 1))
      [ "$lock_attempt" -lt 50 ] || {
        printf '%s\n' "watcher operation remains in progress for $agent_name" >&2
        exit 1
      }
      sleep 0.1
      continue
    fi
    rm -f "$PIEN_WATCH_LOCK/owner"
    rmdir "$PIEN_WATCH_LOCK" 2>/dev/null || {
      printf '%s\n' "cannot recover stale watcher lock for $agent_name" >&2
      exit 1
    }
  done
  printf '%s\n%s\n' "$$" "$(process_start "$$")" >"$PIEN_WATCH_LOCK/owner"
  chmod 600 "$PIEN_WATCH_LOCK/owner"
  trap 'release_lock' EXIT HUP INT TERM
}

write_record() {
  record_file=$1
  shift
  record_tmp=$record_file.tmp.$$
  jq "$@" >"$record_tmp"
  chmod 600 "$record_tmp"
  mv "$record_tmp" "$record_file"
}

update_record() {
  record_file=$1
  jq_filter=$2
  shift 2
  [ -f "$record_file" ] || return 1
  record_tmp=$record_file.tmp.$$
  jq "$@" "$jq_filter" "$record_file" >"$record_tmp"
  chmod 600 "$record_tmp"
  mv "$record_tmp" "$record_file"
}

generation_is_current() {
  record_file=$1
  generation=$2
  [ -f "$record_file" ] && [ "$(jq -r '.generation // ""' "$record_file")" = "$generation" ]
}

close_legacy_watcher() {
  record_file=$1
  [ -f "$record_file" ] || return 0
  watcher_tab_id=$(jq -r '.watcher_tab_id // ""' "$record_file")
  [ -z "$watcher_tab_id" ] || herdr tab close "$watcher_tab_id" >/dev/null 2>&1 || true
  old_generation=$(jq -r '.generation // ""' "$record_file")
  old_agent=$(jq -r '.agent // ""' "$record_file")
  [ -z "$old_agent" ] || rm -f \
    "$PIEN_WATCH_PROMPTS/$old_agent-$old_generation.prompt" \
    "$PIEN_WATCH_LEASES/$old_agent-$old_generation.lease"
}

agent_snapshot() {
  herdr agent get "$1" 2>/dev/null || true
}

wake_controller() {
  target_thread=$1
  message=$2
  PIEN_WAKE_METHOD=
  if [ -n "$target_thread" ] && codex queue --thread "$target_thread" --message "$message" >/dev/null 2>&1; then
    PIEN_WAKE_METHOD=codex_queue
    return 0
  fi
  PIEN_WAKE_METHOD=failed
  return 1
}

reconcile_record() {
  agent_name=$1
  observed_status=${2:-}
  record_file=$(record_path "$agent_name")
  [ -f "$record_file" ] || return 0

  acquire_lock "$agent_name"
  record_state=$(jq -r '.state // "unknown"' "$record_file")
  case "$record_state" in
    preparing|notifying|notified|queued|wake_failed|prompt_failed) release_lock; return 0 ;;
  esac
  generation=$(jq -r '.generation // ""' "$record_file")
  pane_id=$(jq -r '.pane_id // ""' "$record_file")
  stored_session=$(jq -r '.agent_session // ""' "$record_file")
  target_thread=$(jq -r '.target_thread // ""' "$record_file")
  live_info=$(agent_snapshot "${pane_id:-$agent_name}")
  live_name=$(printf '%s\n' "$live_info" | jq -r '.result.agent.name // ""' 2>/dev/null || true)
  live_session=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_session.value // ""' 2>/dev/null || true)
  live_status=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_status // "missing"' 2>/dev/null || printf 'missing')

  if [ "$live_status" = "working" ] || [ "$live_status" = "unknown" ]; then
    # shellcheck disable=SC2016 # jq variable is passed with --arg.
    update_record "$record_file" '.state = "running" | .last_status = $status' --arg status "$live_status"
    release_lock
    return 0
  fi
  case "$live_status" in
    idle|done|blocked|missing) ;;
    *) release_lock; return 0 ;;
  esac

  identity_note=
  if [ -n "$live_name" ] && [ "$live_name" != "$agent_name" ]; then
    identity_note="; pane now belongs to ${live_name}"
  elif [ -n "$stored_session" ] && [ -n "$live_session" ] && [ "$stored_session" != "$live_session" ]; then
    identity_note="; agent session changed"
  fi
  finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # shellcheck disable=SC2016 # jq variables are passed with --arg.
  update_record "$record_file" \
    '.state = "notifying" | .finished_at = $finished | .last_status = $status | .observed_status = $observed' \
    --arg finished "$finished_at" --arg status "$live_status" --arg observed "$observed_status"
  release_lock

  message="Herdr agent ${agent_name} settled with status ${live_status}${identity_note}. Read its live state, pane, and latest Bead checkpoint before advancing or redispatching."
  wake_ok=false
  if wake_controller "$target_thread" "$message"; then
    wake_ok=true
  else
    herdr notification show "Pien wakeup failed" --body "$message" >/dev/null 2>&1 || true
  fi
  wake_method=$PIEN_WAKE_METHOD

  acquire_lock "$agent_name"
  if generation_is_current "$record_file" "$generation"; then
    if [ "$wake_ok" = true ]; then
      # shellcheck disable=SC2016 # jq variables are passed with --arg.
      update_record "$record_file" '.state = $state | .notified_thread = $thread | .wake_method = $method' \
        --arg state queued --arg thread "$target_thread" --arg method "$wake_method"
    else
      update_record "$record_file" '.state = "wake_failed" | .wake_method = "failed"'
    fi
  fi
  release_lock
}

adopt_agent() {
  agent_name=$1
  validate_agent "$agent_name"
  record_file=$(record_path "$agent_name")
  [ -f "$record_file" ] || {
    printf '%s\n' "no watcher record for $agent_name" >&2
    return 1
  }
  live_info=$(agent_snapshot "$agent_name")
  pane_id=$(printf '%s\n' "$live_info" | jq -r '.result.agent.pane_id // ""' 2>/dev/null || true)
  agent_session=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_session.value // ""' 2>/dev/null || true)
  live_status=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_status // "missing"' 2>/dev/null || printf 'missing')
  [ -n "$pane_id" ] || {
    printf '%s\n' "Herdr agent $agent_name is not live" >&2
    return 1
  }

  acquire_lock "$agent_name"
  close_legacy_watcher "$record_file"
  generation=$(jq -r '.generation // ""' "$record_file")
  [ -n "$generation" ] || generation=$(date -u +%Y%m%dT%H%M%SZ)-$$
  if [ "$live_status" = working ]; then
    next_state=running
  else
    next_state=armed
  fi
  # shellcheck disable=SC2016 # jq variables are passed with --arg.
  update_record "$record_file" \
    '.version = 2 | .generation = $generation | .pane_id = $pane | .agent_session = $session | .target_thread = $thread | .state = $state | .last_status = $status | del(.pid, .process_started_at, .watcher_workspace_id, .watcher_tab_id, .watcher_pane_id, .wait_exit, .log)' \
    --arg generation "$generation" --arg pane "$pane_id" --arg session "$agent_session" \
    --arg thread "$CODEX_THREAD_ID" --arg state "$next_state" --arg status "$live_status"
  printf '%s\n' "$CODEX_THREAD_ID" >"$(target_path "$agent_name")"
  chmod 600 "$(target_path "$agent_name")"
  release_lock
  reconcile_record "$agent_name" "$live_status"
}

plugin_startup() {
  for record_file in "$PIEN_WATCH_RECORDS"/*.json; do
    [ -e "$record_file" ] || continue
    agent_name=${record_file##*/}
    agent_name=${agent_name%.json}
    reconcile_record "$agent_name" startup
  done
}

plugin_event() {
  [ "${HERDR_PLUGIN_EVENT:-}" = "pane.agent_status_changed" ] || return 0
  event_json=${HERDR_PLUGIN_EVENT_JSON:-\{\}}
  pane_id=$(printf '%s\n' "$event_json" | jq -r '.data.pane_id // .pane_id // ""' 2>/dev/null || true)
  observed_status=$(printf '%s\n' "$event_json" | jq -r '.data.agent_status // .agent_status // ""' 2>/dev/null || true)
  [ -n "$pane_id" ] || return 0
  for record_file in "$PIEN_WATCH_RECORDS"/*.json; do
    [ -e "$record_file" ] || continue
    [ "$(jq -r '.pane_id // ""' "$record_file")" = "$pane_id" ] || continue
    agent_name=${record_file##*/}
    agent_name=${agent_name%.json}
    reconcile_record "$agent_name" "$observed_status"
  done
}

require_commands
prepare_state

case "${1:-}" in
  --detach)
    [ "$#" -eq 3 ] || usage
    require_controller
    agent_name=$2
    prompt=$3
    validate_agent "$agent_name"
    live_info=$(agent_snapshot "$agent_name")
    pane_id=$(printf '%s\n' "$live_info" | jq -r '.result.agent.pane_id // ""' 2>/dev/null || true)
    agent_session=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_session.value // ""' 2>/dev/null || true)
    live_status=$(printf '%s\n' "$live_info" | jq -r '.result.agent.agent_status // "missing"' 2>/dev/null || printf 'missing')
    [ -n "$pane_id" ] || {
      printf '%s\n' "Herdr agent $agent_name is not live" >&2
      exit 1
    }
    case "$live_status" in
      idle|done) ;;
      *) printf '%s\n' "refusing to prompt $agent_name while status is $live_status" >&2; exit 1 ;;
    esac

    record_file=$(record_path "$agent_name")
    acquire_lock "$agent_name"
    close_legacy_watcher "$record_file"
    generation=$(date -u +%Y%m%dT%H%M%SZ)-$$
    started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    prompt_checksum=$(printf '%s' "$prompt" | cksum | awk '{print $1 ":" $2}')
    # shellcheck disable=SC2016 # jq variables are passed with --arg.
    write_record "$record_file" -n \
      --arg agent "$agent_name" --arg generation "$generation" --arg pane "$pane_id" \
      --arg session "$agent_session" --arg thread "$CODEX_THREAD_ID" --arg started "$started_at" \
      --arg checksum "$prompt_checksum" \
      '{version:2, agent:$agent, mode:"prompt", state:"preparing", generation:$generation, pane_id:$pane, agent_session:$session, target_thread:$thread, started_at:$started, finished_at:null, last_status:null, observed_status:null, notified_thread:null, wake_method:null, prompt_checksum:$checksum}'
    printf '%s\n' "$CODEX_THREAD_ID" >"$(target_path "$agent_name")"
    chmod 600 "$(target_path "$agent_name")"
    release_lock

    if ! herdr agent prompt "$agent_name" "$prompt" --wait --until working --timeout 5000 >/dev/null; then
      acquire_lock "$agent_name"
      update_record "$record_file" '.state = "prompt_failed"'
      release_lock
      printf '%s\n' "failed to observe $agent_name start; task was not re-sent" >&2
      exit 1
    fi
    acquire_lock "$agent_name"
    generation_is_current "$record_file" "$generation" \
      && update_record "$record_file" '.state = "running" | .last_status = "working"'
    release_lock
    reconcile_record "$agent_name" working
    jq '.' "$record_file"
    ;;
  --rearm|--adopt)
    [ "$#" -eq 2 ] || usage
    require_controller
    adopt_agent "$2"
    ;;
  --adopt-all)
    [ "$#" -eq 1 ] || usage
    require_controller
    found=false
    for record_file in "$PIEN_WATCH_RECORDS"/*.json; do
      [ -e "$record_file" ] || continue
      found=true
      agent_name=${record_file##*/}
      agent_name=${agent_name%.json}
      adopt_agent "$agent_name" || true
    done
    [ "$found" = true ] || printf '%s\n' "no watcher records"
    ;;
  --list)
    [ "$#" -eq 1 ] || usage
    for record_file in "$PIEN_WATCH_RECORDS"/*.json; do
      [ -e "$record_file" ] || continue
      jq '.' "$record_file"
    done | jq -s '.'
    ;;
  --clear)
    [ "$#" -eq 2 ] || usage
    validate_agent "$2"
    record_file=$(record_path "$2")
    [ -f "$record_file" ] || exit 0
    record_state=$(jq -r '.state // "unknown"' "$record_file")
    if [ "$record_state" = running ] && [ "$(jq -r '.last_status // ""' "$record_file")" = working ]; then
      printf '%s\n' "refusing to clear an active watcher for $2" >&2
      exit 1
    fi
    acquire_lock "$2"
    close_legacy_watcher "$record_file"
    rm -f "$record_file" "$(target_path "$2")"
    release_lock
    printf '%s\n' "cleared watcher record for $2"
    ;;
  --plugin-startup)
    [ "$#" -eq 1 ] || usage
    plugin_startup
    ;;
  --plugin-event)
    [ "$#" -eq 1 ] || usage
    plugin_event
    ;;
  *) usage ;;
esac
