#!/bin/sh
set -eu

if [ "${HERDR_ENV:-}" != "1" ]; then
  printf '%s\n' "Pien must be launched inside a Herdr-managed pane (HERDR_ENV=1)." >&2
  exit 1
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if ! "$script_dir/install-host" --check >/dev/null 2>&1; then
  printf '%s\n' "Pien host policy is incomplete. Run: ${CODEX_HOME:-$HOME/.codex}/fleet/bin/install-host" >&2
  exit 1
fi

projects_root=${PIEN_PROJECTS_ROOT:-"$HOME/Projects"}
cd "$projects_root"

exec codex \
  --profile pien \
  --dangerously-bypass-hook-trust \
  "$@"
